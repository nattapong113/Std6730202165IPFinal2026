{
  "expo": {
    "name": "HR Manager",
    "slug": "hr-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./frontend/assets/images/icon.png",
    "scheme": "hrmanager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./frontend/assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./frontend/assets/images/android-icon-foreground.png",
        "backgroundImage": "./frontend/assets/images/android-icon-background.png",
        "monochromeImage": "./frontend/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./frontend/assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./frontend/src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./frontend/assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
